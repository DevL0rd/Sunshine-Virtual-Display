#!/usr/bin/env python3
import json
import subprocess
import sys


name = sys.argv[1]
width = int(sys.argv[2])
height = int(sys.argv[3])
refresh = float(sys.argv[4])
result = subprocess.run(["kscreen-doctor", "-j"], capture_output=True, text=True, check=True)
data = json.loads(result.stdout)
output = next((item for item in data.get("outputs", []) if item.get("name") == name), None)
if output is None:
    raise SystemExit(2)
best = None
best_score = None
exact = False
target_area = width * height
target_aspect = width / height
for mode in output.get("modes", []):
    size = mode.get("size", {})
    candidate_width = size.get("width")
    candidate_height = size.get("height")
    candidate_refresh = float(mode.get("refreshRate", 0))
    if not candidate_width or not candidate_height:
        continue
    same_resolution = candidate_width == width and candidate_height == height
    if same_resolution and abs(candidate_refresh - refresh) < 1.0:
        best = mode
        exact = True
        break
    aspect_delta = abs(candidate_width / candidate_height - target_aspect)
    area_delta = abs(candidate_width * candidate_height - target_area) / target_area
    score = (0 if same_resolution else 1, aspect_delta, area_delta, abs(candidate_refresh - refresh))
    if best_score is None or score < best_score:
        best = mode
        best_score = score
if best is None:
    raise SystemExit(3)
print(best["id"])
print("EXACT" if exact else "FALLBACK")
print(best["name"])
