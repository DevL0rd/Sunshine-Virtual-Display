#!/usr/bin/env bash
set -euo pipefail
source "$HOME/.config/sunshine-virtual-display/config"
runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/sunshine-virtual-display"
layout_file="$runtime_dir/layout.json"
count_file="$runtime_dir/session-count"
lock_file="$runtime_dir/lock"
active_file="$runtime_dir/active"
log_file="$STATE_DIR/events.log"
pending_file="$STATE_DIR/pending-modes.txt"
pending_lock_file="$STATE_DIR/pending-modes.lock"
TOUCH_DEVICE_NAME="libvirtualhid Touchscreen"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
mkdir -p "$runtime_dir" "$STATE_DIR"
if [[ ! -e "$pending_file" ]]; then
    touch "$pending_file"
fi
log_event() {
    printf '%s %s\n' "$(date -Is)" "$*" >> "$log_file"
}
output_exists() {
    kscreen-doctor -j | jq -e --arg name "$1" '.outputs[] | select(.name == $name)' >/dev/null
}
start_inhibitor() {
    systemctl --user stop sunshine-vdisplay-inhibit.service >/dev/null 2>&1 || true
    systemctl --user reset-failed sunshine-vdisplay-inhibit.service >/dev/null 2>&1 || true
    systemd-run --user --collect --unit=sunshine-vdisplay-inhibit --description='Sunshine virtual display session inhibitor' kde-inhibit --power --screenSaver sleep infinity >/dev/null
}
stop_inhibitor() {
    systemctl --user stop sunshine-vdisplay-inhibit.service >/dev/null 2>&1 || true
    systemctl --user reset-failed sunshine-vdisplay-inhibit.service >/dev/null 2>&1 || true
}
start_touchscreen_binding() {
    stop_touchscreen_binding
    systemd-run --user --collect --unit="sunshine-vdisplay-touch-bind-$BASHPID" "$HOME/.local/bin/sunshine-vdisplay-bind-touchscreen" >/dev/null
}
stop_touchscreen_binding() {
    systemctl --user stop 'sunshine-vdisplay-touch-bind-*.service' >/dev/null 2>&1 || true
}
bind_touchscreen_output() {
    local uuid ids vendor product event device_path
    uuid="$(kscreen-doctor -o 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | awk -v name="$VIRTUAL_OUTPUT" '$1 == "Output:" && $3 == name {print $4; exit}')"
    [[ -n "$uuid" ]] || return 1
    ids="$(awk -v want="$TOUCH_DEVICE_NAME" '/^I: /{info=$0} $0 ~ "^N: Name=\"" want "\"$" {print info; exit}' /proc/bus/input/devices)"
    [[ -n "$ids" ]] || return 1
    vendor="$(sed -n 's/.*Vendor=\([0-9a-fA-F]*\).*/\1/p' <<< "$ids")"
    product="$(sed -n 's/.*Product=\([0-9a-fA-F]*\).*/\1/p' <<< "$ids")"
    [[ -n "$vendor" && -n "$product" ]] || return 1
    event="$(awk -v want="$TOUCH_DEVICE_NAME" '$0 ~ "^N: Name=\"" want "\"$" {found=1; next} found && /^H: Handlers=/ {for (field=2; field<=NF; field++) {value=$field; sub(/^Handlers=/, "", value); if (value ~ /^event[0-9]+$/) {print value; exit}}}' /proc/bus/input/devices)"
    [[ -n "$event" ]] || return 1
    device_path="/org/kde/KWin/InputDevice/$event"
    kwriteconfig6 --file kcminputrc --group Libinput --group "$((16#$vendor))" --group "$((16#$product))" --group "$TOUCH_DEVICE_NAME" --key OutputUuid "$uuid"
    busctl --user set-property org.kde.KWin "$device_path" org.kde.KWin.InputDevice outputName s "$VIRTUAL_OUTPUT" >/dev/null 2>&1 || return 1
    busctl --user call org.kde.KWin /KWin org.kde.KWin reconfigure >/dev/null 2>&1 || true
    printf '%s' "$uuid"
}
