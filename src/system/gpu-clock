#!/usr/bin/env bash
set -euo pipefail
GPU_INDEX=0
GPU_GRAPHICS_CLOCK=3105
if [[ -r /etc/sunshine-virtual-display/config ]]; then
    source /etc/sunshine-virtual-display/config
fi
[[ "$GPU_INDEX" =~ ^[0-9]+$ ]]
[[ "$GPU_GRAPHICS_CLOCK" =~ ^[0-9]+$ ]]
case "${1:-}" in
    lock)
        exec /usr/bin/nvidia-smi -i "$GPU_INDEX" -lgc "$GPU_GRAPHICS_CLOCK,$GPU_GRAPHICS_CLOCK"
        ;;
    reset)
        exec /usr/bin/nvidia-smi -i "$GPU_INDEX" -rgc
        ;;
    *)
        exit 2
        ;;
esac
